{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/api?__weflo_path=" },
    { "source": "/api/(.*)", "destination": "/api?__weflo_path=api/$1" },
    { "source": "/s/(.*)", "destination": "/api?__weflo_path=s/$1" }
  ]
}
