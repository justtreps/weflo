{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/api?__weflo_scope=root" },
    { "source": "/api/:path*", "destination": "/api?__weflo_scope=api" },
    { "source": "/s/:path*", "destination": "/api?__weflo_scope=s" }
  ]
}
