<section class="wf-wrap wf-sec">
  <h2>{{ section.settings.heading | default: "Avis" }}</h2>
  <div class="wf-grid">
    {% for block in section.blocks %}
      <blockquote class="wf-card">
        <p>{{ block.settings.text }}</p>
        <p class="wf-kicker">{{ block.settings.heading }}</p>
      </blockquote>
    {% else %}
      <blockquote class="wf-card"><p>{{ section.settings.text | default: "Exactement ce que je cherchais." }}</p><p class="wf-kicker">Client Weflo</p></blockquote>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre" },
    { "type": "textarea", "id": "text", "label": "Texte" }
  ],
  "blocks": [
    { "type": "review", "name": "Avis", "settings": [
      { "type": "text", "id": "heading", "label": "Auteur" },
      { "type": "textarea", "id": "text", "label": "Citation" }
    ]}
  ]
}
{% endschema %}
