<section class="weflo-section weflo-section--{{ section.type }}"><div class="weflo-section__header"><p>{{ section.settings.subtitle | escape }}</p><h2>{{ section.settings.title | escape }}</h2><div>{{ section.settings.text }}</div></div>{% for block in section.blocks %}<article {{ block.shopify_attributes }}><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}{% if section.settings.cta_label != blank %}<a href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>{% endif %}</section>
{% schema %}{"name":"Weflo contenu","settings":[{"type":"text","id":"subtitle","label":"Sous-titre"},{"type":"text","id":"title","label":"Titre"},{"type":"richtext","id":"text","label":"Texte"},{"type":"text","id":"cta_label","label":"Bouton"},{"type":"url","id":"cta_link","label":"Lien"}],"blocks":[{"type":"item","name":"Élément","settings":[{"type":"text","id":"title","label":"Titre"},{"type":"textarea","id":"text","label":"Texte"},{"type":"range","id":"rating","label":"Note","min":1,"max":5,"step":1,"default":5}]}],"presets":[{"name":"Weflo contenu"}]}{% endschema %}

